# Copiar a backend/.env y completar con valores reales.
# backend/.env nunca se commitea (esta cubierto por el .gitignore raiz).

# ---------------------------------------------------------------------
# Obligatorias en cualquier entorno
# ---------------------------------------------------------------------

# API key de Google AI Studio (Gemini). Sin ella la app no arranca.
GEMINI_API_KEY=

# Token del bot obtenido con @BotFather. Necesario para el canal
# Telegram (sendMessage desde el webhook).
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------
# Obligatorio en produccion (Render)
# ---------------------------------------------------------------------

# Secret que Telegram reenvia en el header
# X-Telegram-Bot-Api-Secret-Token del webhook. En produccion es
# OBLIGATORIO: sin el, /telegram/webhook aceptaria updates forjados.
# Debe coincidir con el registrado por scripts/set_telegram_webhook.py
# (en Render se auto-genera via render.yaml; leerlo del dashboard).
TELEGRAM_WEBHOOK_SECRET=

# Token compartido que protege /agenda y /reviews via header
# X-Admin-Token. Opcional en desarrollo (sin token, quedan abiertas);
# en produccion la app no arranca sin el.
ADMIN_API_TOKEN=
